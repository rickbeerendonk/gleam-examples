{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  // Runs the Gleam package that contains the active file (walks up to gleam.toml).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start",
      "runOptions": {
        "instanceLimit": 1,
        "reevaluateOnRerun": true
      },
      "type": "shell",
      "command": "d=\"${fileDirname}\"; while [ ! -f \"$d/gleam.toml\" ] && [ \"$d\" != / ]; do d=$(dirname \"$d\"); done; cd \"$d\" && gleam run",
      "options": {
        "env": {
          "PATH": "/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Test",
      "runOptions": {
        "instanceLimit": 1,
        "reevaluateOnRerun": true
      },
      "type": "shell",
      "command": "d=\"${fileDirname}\"; while [ ! -f \"$d/gleam.toml\" ] && [ \"$d\" != / ]; do d=$(dirname \"$d\"); done; cd \"$d\" && gleam test",
      "options": {
        "env": {
          "PATH": "/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
        }
      },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
